<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F12"
    android:fitsSystemWindows="true"
    android:paddingTop="28dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#0F0F12">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tin nhắn mới"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCancelNewChat"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Hủy"
            android:textColor="#A020F0"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- SCROLL FORM -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SECTION: Thông tin quán -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông tin cuộc trò chuyện"
                android:textColor="#9CA0AA"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginStart="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp" />

            <!-- Emoji / Avatar quán -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emoji quán"
                    android:textColor="#8A8A95"
                    android:textSize="13sp"
                    android:layout_marginEnd="12dp"
                    android:minWidth="80dp" />

                <EditText
                    android:id="@+id/shopAvatarInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/search_bg"
                    android:hint="💬"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A8A95"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

            </LinearLayout>

            <!-- Tên quán / tiêu đề chat -->
            <EditText
                android:id="@+id/searchShopInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/search_bg"
                android:hint="Tên quán / tiêu đề chat..."
                android:textColor="#FFFFFF"
                android:textColorHint="#8A8A95"
                android:textSize="14sp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionNext"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:enabled="true"
                android:cursorVisible="true"
                android:autofillHints="name" />

            <!-- Loại quán / category -->
            <EditText
                android:id="@+id/shopCategoryInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/search_bg"
                android:hint="Loại quán (ẩm thực, cà phê, bar...)"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A8A95"
                android:textSize="14sp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionNext"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Địa chỉ -->
            <EditText
                android:id="@+id/shopAddressInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/search_bg"
                android:hint="Địa chỉ quán..."
                android:textColor="#FFFFFF"
                android:textColorHint="#8A8A95"
                android:textSize="14sp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionNext"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Giờ mở / đóng cửa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/shopOpenTimeInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/search_bg"
                    android:hint="Mở: 18:00"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A8A95"
                    android:textSize="14sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <EditText
                    android:id="@+id/shopCloseTimeInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/search_bg"
                    android:hint="Đóng: 02:30"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A8A95"
                    android:textSize="14sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

            </LinearLayout>

            <!-- SECTION: Tin nhắn -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tin nhắn đầu tiên"
                android:textColor="#9CA0AA"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <!-- TIN NHẮN ĐẦU TIÊN -->
            <EditText
                android:id="@+id/firstMessageInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/search_bg"
                android:hint="Nhập tin nhắn đầu tiên..."
                android:textColor="#FFFFFF"
                android:textColorHint="#8A8A95"
                android:textSize="14sp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:enabled="true"
                android:cursorVisible="true" />

            <!-- NÚT TẠO -->
            <TextView
                android:id="@+id/btnCreateConversation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="✎  Tạo cuộc trò chuyện"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/favorite_filled_btn" />

            <!-- GỢI Ý -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gợi ý quán đang mở gần bạn"
                android:textColor="#9CA0AA"
                android:textSize="13sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" />

            <!-- SHOP 1 -->
            <LinearLayout
                android:id="@+id/newChatBunBo"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="#1A1A1F">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="🍜"
                    android:textSize="26sp"
                    android:background="@drawable/marker_green_bg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bún Bò Huế 24h"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang mở • Cách 0,5 km"
                        android:textColor="#32CD32"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Nhắn"
                    android:textColor="#A020F0"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/quick_action_bg" />

            </LinearLayout>

            <!-- SHOP 2 -->
            <LinearLayout
                android:id="@+id/newChatLau"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="🍲"
                    android:textSize="26sp"
                    android:background="@drawable/marker_green_bg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lẩu Thái Nửa Đêm"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang mở • Mở tới 03:00"
                        android:textColor="#32CD32"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Nhắn"
                    android:textColor="#A020F0"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/quick_action_bg" />

            </LinearLayout>

            <!-- SHOP 3 -->
            <LinearLayout
                android:id="@+id/newChatBBQ"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="#1A1A1F">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="🍢"
                    android:textSize="26sp"
                    android:background="@drawable/marker_orange_bg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nhậu và Có BBQ"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang mở • Phù hợp đi nhóm"
                        android:textColor="#32CD32"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Nhắn"
                    android:textColor="#A020F0"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/quick_action_bg" />

            </LinearLayout>

            <!-- SHOP 4 -->
            <LinearLayout
                android:id="@+id/newChatChe"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="🍧"
                    android:textSize="26sp"
                    android:background="@drawable/marker_green_bg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chè Khuya Hà Nội"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang mở • Món ngọt buổi khuya"
                        android:textColor="#32CD32"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Nhắn"
                    android:textColor="#A020F0"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/quick_action_bg" />

            </LinearLayout>

            <!-- SHOP 5 -->
            <LinearLayout
                android:id="@+id/newChatPizza"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="#1A1A1F">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="🍕"
                    android:textSize="26sp"
                    android:background="@drawable/marker_red_bg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pizza Midnight"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang mở • Có ưu đãi đêm"
                        android:textColor="#32CD32"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Nhắn"
                    android:textColor="#A020F0"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/quick_action_bg" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>