<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/avatarCropRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:background="@color/surface_bg">

        <TextView
            android:id="@+id/btnCancelCrop"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:text="@string/cancel"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/choose_avatar"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btnSaveCrop"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:gravity="center_vertical|end"
            android:text="@string/save"
            android:textColor="@color/primary_color"
            android:textStyle="bold"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- CROP AREA -->
    <FrameLayout
        android:id="@+id/cropContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="74dp"
        android:layout_marginBottom="100dp">

        <ImageView
            android:id="@+id/cropImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="matrix"
            android:contentDescription="@string/choose_avatar" />

        <View
            android:id="@+id/cropFrame"
            android:layout_width="290dp"
            android:layout_height="290dp"
            android:layout_gravity="center"
            android:background="@drawable/avatar_crop_frame" />

    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:text="@string/drag_zoom_avatar"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp" />

</FrameLayout>