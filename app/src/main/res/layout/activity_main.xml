<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F12"
    android:paddingTop="34dp">

    <!-- HEADER CỐ ĐỊNH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#0F0F12">

        <!-- LOGO -->
        <androidx.cardview.widget.CardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            app:cardCornerRadius="100dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#080812">

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo"
                android:contentDescription="Logo NightLife Finder" />

        </androidx.cardview.widget.CardView>

        <!-- SEARCH -->
        <EditText
            android:id="@+id/etHomeSearch"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/search_bg"
            android:hint="Tìm món ăn đêm..."
            android:textColorHint="#8A8A95"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:inputType="text"
            android:autofillHints="search" />

        <!-- CHUÔNG -->
        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="100dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#171720">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🔔"
                android:textSize="18sp"
                android:textColor="#FFFFFF" />

        </androidx.cardview.widget.CardView>

        <!-- AVATAR TẠM THỜI -->
        <ImageView
            android:id="@+id/imgHomeAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/logo"
            android:scaleType="centerCrop"
            android:contentDescription="Avatar" />

    </LinearLayout>

    <!-- NỘI DUNG KÉO ĐƯỢC -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="22dp">

            <!-- ƯU ĐÃI CHỚP NHOÁNG -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Ưu đãi chớp nhoáng"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="19sp"
                android:paddingStart="15dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp" />

            <!-- FLASH DEALS VUỐT NGANG -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">

                    <!-- DEAL 1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/dealCard1"
                        android:layout_width="175dp"
                        android:layout_height="125dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#1A1A1F">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/burger"
                                android:contentDescription="Bún bò Đêm Phố Cổ" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#78000000" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="8dp"
                                android:paddingStart="9dp"
                                android:paddingEnd="9dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:text="Giảm 50%"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:background="@drawable/tag_purple" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bún bò Đêm Phố Cổ"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/txtCountdown1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⏱ Còn 02:15:30"
                                    android:textColor="#DADAE0"
                                    android:textSize="10sp" />

                            </LinearLayout>

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- DEAL 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/dealCard2"
                        android:layout_width="175dp"
                        android:layout_height="125dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#1A1A1F">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/sushi"
                                android:contentDescription="Lẩu khuya Hoàn Kiếm" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#78000000" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="8dp"
                                android:paddingStart="9dp"
                                android:paddingEnd="9dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:text="Nước miễn phí"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:background="@drawable/tag_purple" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Lẩu khuya Hoàn Kiếm"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/txtCountdown2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⏱ Còn 00:45:10"
                                    android:textColor="#DADAE0"
                                    android:textSize="10sp" />

                            </LinearLayout>

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- DEAL 3 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/dealCard3"
                        android:layout_width="175dp"
                        android:layout_height="125dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#1A1A1F">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/pizza"
                                android:contentDescription="Pizza" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#78000000" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="8dp"
                                android:paddingStart="9dp"
                                android:paddingEnd="9dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:text="Mua 1 tặng 1"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:background="@drawable/tag_purple" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pizza Midnight Hà Nội"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/txtCountdown3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⏱ Còn 05:00:00"
                                    android:textColor="#DADAE0"
                                    android:textSize="10sp" />

                            </LinearLayout>

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- DEAL 4 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/dealCard4"
                        android:layout_width="175dp"
                        android:layout_height="125dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#1A1A1F">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/bar"
                                android:contentDescription="Đồ nướng Hàng Bạc" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#78000000" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="8dp"
                                android:paddingStart="9dp"
                                android:paddingEnd="9dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:text="Combo đêm"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:background="@drawable/tag_purple" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Đồ nướng Hàng Bạc"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/txtCountdown4"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⏱ Còn 01:20:00"
                                    android:textColor="#DADAE0"
                                    android:textSize="10sp" />

                            </LinearLayout>

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- NỔI BẬT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="24dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔥 Nổi bật tuần này"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/btnViewAllHot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem tất cả"
                    android:textColor="#00BFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- CARD LỚN 1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHot1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1A1F"
                app:strokeWidth="1dp"
                app:strokeColor="#242430">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="138dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/bar"
                            android:contentDescription="Bạch tuộc Neon" />

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="end"
                            android:gravity="center"
                            android:text="❤️"
                            android:textSize="18sp" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ 4.9  (342)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Bạch tuộc Neon"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="17sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Nướng • 8 Tạ Hiện, Hoàn Kiếm • Mở đến 02:00"
                            android:textColor="#9CA0AA"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD LỚN 2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHot2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="18dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1A1F"
                app:strokeWidth="1dp"
                app:strokeColor="#242430">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="138dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/bar"
                            android:contentDescription="Cơm Tấm Đêm Hà Nội" />

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="end"
                            android:gravity="center"
                            android:text="♡"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ 4.7  (890)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Cơm Tấm Đêm Hà Nội"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="17sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Cơm • 52 Hàng Bông, Hoàn Kiếm • Mở đến 03:00"
                            android:textColor="#9CA0AA"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- GẦN BẠN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="6dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📍 Gần bạn"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/btnViewMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem bản đồ"
                    android:textColor="#00BFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- NEAR 1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNear1"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1A1F"
                app:strokeWidth="1dp"
                app:strokeColor="#242430">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/diner"
                        android:contentDescription="Quán ăn Starlight" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quán ăn Starlight"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ 4.5 • Quán ăn cổ điển"
                            android:textColor="#A0A0A8"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Mở cửa đến 2 giờ sáng"
                            android:textColor="#32CD32"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0,2 dặm"
                        android:textColor="#A0A0A8"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- NEAR 2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNear2"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1A1F"
                app:strokeWidth="1dp"
                app:strokeColor="#242430">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/pizza"
                        android:contentDescription="Pizza lát đỏ thẫm" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pizza lát đỏ thẫm"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ 4.8 • Pizza Ý"
                            android:textColor="#A0A0A8"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Sắp đóng cửa"
                            android:textColor="#FFB84D"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0,4 dặm"
                        android:textColor="#A0A0A8"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- AI GỢI Ý -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍵 Gợi ý cho bạn"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="19sp"
                android:paddingStart="15dp"
                android:paddingTop="8dp"
                android:paddingBottom="10dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAiSuggest"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="12dp"
