<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="38dp"
        android:paddingBottom="76dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtChatTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trò chuyện"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtChatCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 cuộc trò chuyện"
                    android:textColor="#9CA0AA"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/btnSearchChat"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#A020F0"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/btnNewChatTop"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="✎"
                android:textColor="#A020F0"
                android:textSize="24sp" />

        </LinearLayout>

        <!-- SEARCH -->
        <EditText
            android:id="@+id/chatSearchInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/search_bg"
            android:hint="Tìm cuộc trò chuyện..."
            android:textColor="#FFFFFF"
            android:textColorHint="#8A8A95"
            android:textSize="14sp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:enabled="true"
            android:cursorVisible="true"
            android:autofillHints="search" />

        <!-- FILTER CHIPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginEnd="8dp"
                android:text="Tất cả"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:background="@drawable/chip_active_bg" />

            <TextView
                android:id="@+id/chipUnread"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Chưa đọc"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:background="@drawable/chip_bg" />

        </LinearLayout>

        <!-- CHAT LIST -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chatListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ITEM 1 -->
                <FrameLayout
                    android:id="@+id/chatBunBoRow"
                    android:layout_width="match_parent"
                    android:layout_height="82dp">

                    <TextView
                        android:id="@+id/deleteBunBo"
                        android:layout_width="92dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="Xóa"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/chat_delete_bg" />

                    <LinearLayout
                        android:id="@+id/chatBunBoFront"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#1A1A1F"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp">

                            <TextView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:gravity="center"
                                android:text="🍜"
                                android:textSize="26sp"
                                android:background="@drawable/marker_green_bg" />

                            <TextView
                                android:id="@+id/badgeBunBo"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="end|top"
                                android:gravity="center"
                                android:text="2"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:background="@drawable/marker_red_bg" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bún Bò Huế 24h"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dạ còn 3 bàn trống anh ơi! Mời anh..."
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="23:42"
                            android:textColor="#A020F0"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </FrameLayout>

                <!-- ITEM 2 -->
                <FrameLayout
                    android:id="@+id/chatLauRow"
                    android:layout_width="match_parent"
                    android:layout_height="82dp">

                    <TextView
                        android:id="@+id/deleteLau"
                        android:layout_width="92dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="Xóa"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/chat_delete_bg" />

                    <LinearLayout
                        android:id="@+id/chatLauFront"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#1A1A1F"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp">

                            <TextView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:gravity="center"
                                android:text="🍲"
                                android:textSize="26sp"
                                android:background="@drawable/marker_green_bg" />

                            <TextView
                                android:id="@+id/badgeLau"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="end|top"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:background="@drawable/marker_red_bg" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lẩu Thái Nửa Đêm"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Menu nóng hôm nay có thêm hải sản..."
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="23:15"
                            android:textColor="#A020F0"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </FrameLayout>

                <!-- ITEM 3 -->
                <FrameLayout
                    android:id="@+id/chatBBQRow"
                    android:layout_width="match_parent"
                    android:layout_height="82dp">

                    <TextView
                        android:id="@+id/deleteBBQ"
                        android:layout_width="92dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="Xóa"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/chat_delete_bg" />

                    <LinearLayout
                        android:id="@+id/chatBBQFront"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:background="#0F0F12">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:text="🍢"
                            android:textSize="26sp"
                            android:background="@drawable/marker_orange_bg" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nhậu và Có BBQ"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cảm ơn anh đã ghé quán nhé 🙏"
                                android:textColor="#8A8A95"
                                android:textSize="13sp"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="22:30"
                            android:textColor="#8A8A95"
                            android:textSize="12sp" />

                    </LinearLayout>

                </FrameLayout>

                <!-- ITEM 4 -->
                <FrameLayout
                    android:id="@+id/chatCheRow"
                    android:layout_width="match_parent"
                    android:layout_height="82dp">

                    <TextView
                        android:id="@+id/deleteChe"
                        android:layout_width="92dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="Xóa"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/chat_delete_bg" />

                    <LinearLayout
                        android:id="@+id/chatCheFront"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:background="#0F0F12">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:text="🍧"
                            android:textSize="26sp"
                            android:background="@drawable/marker_green_bg" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chè Khuya Hà Nội"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hôm nay có chè khúc bạch đặc biệt..."
                                android:textColor="#8A8A95"
                                android:textSize="13sp"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="21:50"
                            android:textColor="#8A8A95"
                            android:textSize="12sp" />

                    </LinearLayout>

                </FrameLayout>

                <!-- ITEM 5 -->
                <FrameLayout
                    android:id="@+id/chatPizzaRow"
                    android:layout_width="match_parent"
                    android:layout_height="82dp">

                    <TextView
                        android:id="@+id/deletePizza"
                        android:layout_width="92dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="Xóa"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/chat_delete_bg" />

                    <LinearLayout
                        android:id="@+id/chatPizzaFront"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:background="#0F0F12">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:text="🍕"
                            android:textSize="26sp"
                            android:background="@drawable/marker_red_bg" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pizza Midnight"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quán đóng cửa lúc 4h sáng anh nhé"
                                android:textColor="#8A8A95"
                                android:textSize="13sp"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hôm qua"
                            android:textColor="#8A8A95"
                            android:textSize="12sp" />

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- FLOATING BUTTON -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnNewChat"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="96dp"
        app:cardCornerRadius="100dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#A020F0">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✎"
            android:textColor="#FFFFFF"
            android:textSize="28sp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- BOTTOM NAV - TRÒ CHUYỆN ACTIVE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#1A1A1F"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_home"
                android:tint="#8A8A95"
                android:contentDescription="Trang chủ" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trang chủ"
                android:textColor="#8A8A95"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_map"
                android:tint="#8A8A95"
                android:contentDescription="Bản đồ" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bản đồ"
                android:textColor="#8A8A95"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_chat"
                android:tint="#A020F0"
                android:contentDescription="Trò chuyện" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trò chuyện"
                android:textColor="#A020F0"
                android:textStyle="bold"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navFavorite"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_favorite"
                android:tint="#8A8A95"
                android:contentDescription="Yêu thích" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yêu thích"
                android:textColor="#8A8A95"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_profile"
                android:tint="#8A8A95"
                android:contentDescription="Hồ sơ" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hồ sơ"
                android:textColor="#8A8A95"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>