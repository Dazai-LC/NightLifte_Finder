<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F12">

    <!-- KHU VỰC MAP DEMO -->
    <FrameLayout
        android:id="@+id/demoMapArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="76dp"
        android:background="#101018">

        <!-- MAP CANVAS -->
        <FrameLayout
            android:id="@+id/mapCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- NỀN HỒ / KHU VỰC TỐI -->
            <View
                android:layout_width="260dp"
                android:layout_height="360dp"
                android:layout_marginStart="-80dp"
                android:layout_marginTop="60dp"
                android:background="#071F2B" />

            <!-- ĐƯỜNG PHỐ DEMO -->
            <View
                android:layout_width="520dp"
                android:layout_height="6dp"
                android:layout_marginStart="-60dp"
                android:layout_marginTop="190dp"
                android:rotation="22"
                android:background="#2A3446" />

            <View
                android:layout_width="500dp"
                android:layout_height="6dp"
                android:layout_marginStart="-80dp"
                android:layout_marginTop="360dp"
                android:rotation="-18"
                android:background="#263044" />

            <View
                android:layout_width="520dp"
                android:layout_height="5dp"
                android:layout_marginStart="-40dp"
                android:layout_marginTop="540dp"
                android:rotation="10"
                android:background="#202938" />

            <View
                android:layout_width="6dp"
                android:layout_height="620dp"
                android:layout_marginStart="100dp"
                android:layout_marginTop="90dp"
                android:rotation="-10"
                android:background="#202938" />

            <View
                android:layout_width="6dp"
                android:layout_height="620dp"
                android:layout_marginStart="270dp"
                android:layout_marginTop="80dp"
                android:rotation="12"
                android:background="#283246" />

            <View
                android:layout_width="360dp"
                android:layout_height="5dp"
                android:layout_marginStart="50dp"
                android:layout_marginTop="700dp"
                android:rotation="-8"
                android:background="#202938" />

            <!-- HỒ HOÀN KIẾM DEMO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="150dp"
                android:layout_height="190dp"
                android:layout_marginStart="165dp"
                android:layout_marginTop="280dp"
                app:cardCornerRadius="80dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#072331"
                app:strokeWidth="1dp"
                app:strokeColor="#0B4A5E" />

            <!-- LABEL KHU VỰC -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="165dp"
                android:layout_marginTop="245dp"
                android:text="HỒ HOÀN KIẾM"
                android:textColor="#53606F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:rotation="-8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="55dp"
                android:layout_marginTop="155dp"
                android:text="PHỐ CỔ HÀ NỘI"
                android:textColor="#53606F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:rotation="18" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="245dp"
                android:layout_marginTop="590dp"
                android:text="ĐINH TIÊN HOÀNG"
                android:textColor="#53606F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:rotation="8" />

            <!-- VỊ TRÍ CỦA BẠN -->
            <TextView
                android:id="@+id/markerMe"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="176dp"
                android:layout_marginTop="390dp"
                android:gravity="center"
                android:text="◎"
                android:textColor="#00BFFF"
                android:textSize="34sp"
                android:background="@drawable/marker_blue_bg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="166dp"
                android:layout_marginTop="446dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Vị trí của bạn"
                android:textColor="#00BFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/map_label_bg" />

            <!-- MARKER QUÁN ĂN -->
            <TextView
                android:id="@+id/markerBunBo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="74dp"
                android:layout_marginTop="230dp"
                android:gravity="center"
                android:text="🍜"
                android:textSize="22sp"
                android:background="@drawable/marker_purple_bg" />

            <TextView
                android:id="@+id/markerNuong"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="270dp"
                android:layout_marginTop="180dp"
                android:gravity="center"
                android:text="🍢"
                android:textSize="22sp"
                android:background="@drawable/marker_orange_bg" />

            <TextView
                android:id="@+id/markerLau"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="300dp"
                android:layout_marginTop="465dp"
                android:gravity="center"
                android:text="🍲"
                android:textSize="22sp"
                android:background="@drawable/marker_green_bg" />

            <TextView
                android:id="@+id/markerPizza"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="112dp"
                android:layout_marginTop="560dp"
                android:gravity="center"
                android:text="🍕"
                android:textSize="22sp"
                android:background="@drawable/marker_red_bg" />

            <TextView
                android:id="@+id/markerTea"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="48dp"
                android:layout_marginTop="430dp"
                android:gravity="center"
                android:text="🧋"
                android:textSize="22sp"
                android:background="@drawable/marker_yellow_bg" />

        </FrameLayout>

        <!-- CARD THÔNG TIN QUÁN -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="98dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1A1A1F"
            app:strokeWidth="1dp"
            app:strokeColor="#2D2D3A">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/placeEmoji"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:gravity="center"
                    android:text="🍜"
                    android:textSize="28sp"
                    android:background="@drawable/marker_purple_bg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/placeName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bún bò Đêm Phố Cổ"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/placeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mở đến 02:30 • 0,5 km"
                        android:textColor="#A0A0A8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/placeRoute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI gợi ý: đường nhanh nhất khoảng 5 phút"
                        android:textColor="#32CD32"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- TOP UI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="42dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <EditText
            android:id="@+id/mapSearchInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/search_bg"
            android:hint="Tìm quán ăn đêm ở Hà Nội..."
            android:textColor="#FFFFFF"
            android:textColorHint="#8A8A95"
            android:textSize="14sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:singleLine="true"
            android:inputType="text"
            android:autofillHints="search" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipBunBo"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:layout_marginEnd="8dp"
                    android:text="🍜 Bún bò"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:background="@drawable/chip_active_bg" />

                <TextView
                    android:id="@+id/chipNuong"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:layout_marginEnd="8dp"
                    android:text="🍢 Nướng"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:background="@drawable/chip_bg" />

                <TextView
                    android:id="@+id/chipLau"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:layout_marginEnd="8dp"
                    android:text="🍲 Lẩu"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:background="@drawable/chip_bg" />

                <TextView
                    android:id="@+id/chipTraSua"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:layout_marginEnd="8dp"
                    android:text="🧋 Trà sữa"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:background="@drawable/chip_bg" />

                <TextView
                    android:id="@+id/chipPizza"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:layout_marginEnd="8dp"
                    android:text="🍕 Pizza"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:background="@drawable/chip_bg" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- MAP CONTROLS -->
    <LinearLayout
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:gravity="center">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnMyLocation"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="100dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#263240"
            app:cardBackgroundColor="#1A1A1F">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⌖"
                android:textColor="#00BFFF"
                android:textSize="24sp" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="52dp"
            android:layout_height="96dp"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#263240"
            app:cardBackgroundColor="#1A1A1F">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnZoomIn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2D2D3A" />

                <TextView
                    android:id="@+id/btnZoomOut"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnToggle3D"
            android:layout_width="52dp"
            android:layout_height="42dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#8A2BE2"
            app:cardBackgroundColor="#1A1A1F">

            <TextView
                android:id="@+id/txtToggle3D"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="3D"
                android:textColor="#A020F0"
                android:textStyle="bold"
                android:textSize="13sp" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- BOTTOM NAV - BẢN ĐỒ ACTIVE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#1A1A1F"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_home"
                android:tint="#8A8A95"
                android:contentDescription="Trang chủ" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trang chủ"
                android:textColor="#8A8A95"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_map"
                android:tint="#A020F0"
                android:contentDescription="Bản đồ" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bản đồ"
                android:textColor="#A020F0"
                android:textStyle="bold"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_chat"
                android:tint="#8A8A95"
                android:contentDescription="Trò chuyện" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trò chuyện"
                android:textColor="#8A8A95"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navFavorite"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_favorite"
                android:tint="#8A8A95"
                android:contentDescription="Yêu thích" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yêu thích"
                android:textColor="#8A8A95"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_profile"
                android:tint="#8A8A95"
                android:contentDescription="Hồ sơ" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hồ sơ"
                android:textColor="#8A8A95"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>